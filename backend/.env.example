MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/subhan_care_hms?retryWrites=true&w=majority

# JWT Secret & Expiry
JWT_SECRET=subhan_care_super_secret_jwt_key_2026_change_in_production
